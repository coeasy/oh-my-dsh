# Optional. Copy to `.env` in this repository for local development only.
# Never commit a real key. Desktop users can also put `.env` next to the exe.
DEEPSEEK_API_KEY=

# Optional GitHub token. Raises API rate limits when resolving Harness releases.
# GITHUB_TOKEN=
# GH_TOKEN=

# Optional. Pin a Harness git tag instead of the stable/latest channel.
# DSH_ENGINE_REF=v0.1.0-rc.5

# Optional. Override the gitignored clone directory (default: ./deepseek-harness).
# DSH_ENGINE_ROOT=

# Optional. After packing, install the VSIX into Cursor/VS Code.
# DSH_INSTALL=1
