{
  "name": "@coeasy/dsh-plugin-marketplace",
  "version": "0.1.1",
  "description": "Plugin marketplace for DeepSeek Harness — browse, install, update and manage community plugins through the official dsh CLI. · DSH 插件市场：逛、搜、一键安装，全部走官方通道。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  },
  "files": [
    "lib",
    "client",
    "data",
    "cordis.patch.yml",
    "LICENSE"
  ],
  "scripts": {
    "build:host": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=lib/index.js",
    "build:client": "tsdown",
    "build": "pnpm run build:host && pnpm run build:client",
    "test": "node --test tests/"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "~18.3.1",
    "esbuild": "^0.28.2",
    "react": "~18.3.1",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "license": "MIT"
}
